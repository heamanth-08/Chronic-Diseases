{
  "name": "vitascreen-root",
  "version": "1.0.0",
  "description": "VitaScreen — AI-Powered Early Chronic Disease Risk Screening & Health Monitoring Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn backend.main:app --reload --port 8000",
    "install:all": "npm --prefix frontend install && pip install -r backend/requirements.txt",
    "build:frontend": "npm run build --prefix frontend",
    "start": "python backend/run.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "keywords": [
    "vitascreen",
    "health-tech",
    "risk-screening",
    "ai",
    "fastapi",
    "react"
  ],
  "author": "VitaScreen Team",
  "license": "MIT"
}
